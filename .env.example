# Bottleneck Playground — defaults para DESENVOLVIMENTO LOCAL com Laravel Sail.
# Copie para .env (cp .env.example .env) e rode scripts/setup.sh, que:
#   - preenche WWWUSER/WWWGROUP com `id -u`/`id -g` do seu usuário Linux;
#   - gera APP_KEY somente se estiver vazia.
# As credenciais abaixo servem apenas para o ambiente local. Nunca use em produção.
# Portas: se 8000/5173/5432/6379 estiverem ocupadas no host, altere APP_PORT
# (e APP_URL junto), VITE_PORT, FORWARD_DB_PORT ou FORWARD_REDIS_PORT.

APP_NAME="Bottleneck Playground"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
VITE_PORT=5173
COMPOSE_PROJECT_NAME=bottleneck-playground

# UID/GID do seu usuário no host (scripts/setup.sh preenche no .env).
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=bottleneck_playground
DB_USERNAME=sail
DB_PASSWORD=password
# Porta publicada no host (127.0.0.1) para clientes SQL externos.
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SAIL_XDEBUG_MODE=off
